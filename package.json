{
  "name": "dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "lint": "vue-cli-service lint"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "core-js": "^3.49.0",
    "material-design-icons-iconfont": "^3.0.3",
    "roboto-fontface": "*",
    "vee-validate": "^2.2.8",
    "vue": "^2.6.10",
    "vue-axios": "^2.1.4",
    "vue-router": "^3.0.3",
    "vuetify": "^2.7.2",
    "vuex": "^3.0.1"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.29.7",
    "@vue/cli-plugin-babel": "^5.0.9",
    "@vue/cli-plugin-eslint": "^5.0.9",
    "@vue/cli-service": "^5.0.9",
    "@vue/eslint-config-standard": "^8.0.1",
    "cache-loader": "^4.1.0",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.33.0",
    "playwright": "^1.61.0",
    "sass": "^1.101.0",
    "sass-loader": "^10.5.2",
    "stylus": "^0.54.5",
    "stylus-loader": "^3.0.1",
    "vue-template-compiler": "^2.6.10"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/essential",
      "@vue/standard"
    ],
    "rules": {
      "vue/multi-word-component-names": "off",
      "vue/no-v-text-v-html-on-component": "warn"
    },
    "parserOptions": {
      "parser": "@babel/eslint-parser"
    }
  },
  "postcss": {
    "plugins": {
      "autoprefixer": {}
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions"
  ]
